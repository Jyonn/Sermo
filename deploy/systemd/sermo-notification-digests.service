[Unit]
Description=Sermo aggregated notification delivery
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Sermo
EnvironmentFile=-/home/ubuntu/Sermo/.env
ExecStart=/home/ubuntu/envs/sermo/bin/python manage.py process_notification_digests --limit-users 500
Nice=5

